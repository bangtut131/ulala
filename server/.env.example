# Server Configuration
PORT=3001

# Supabase Configuration
# Retrieve these from your Supabase project settings
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# AI Configuration
# For Gemini, use your Gemini API Key here.
# If using a Custom Provider (like OpenAI or compatible), put that key here too.
GEMINI_API_KEY=YOUR_AI_API_KEY

# WAHA (WhatsApp) Configuration
WAHA_BASE_URL=YOUR_WAHA_URL
WAHA_SESSION_ID=Gamatriana
WAHA_API_KEY=
